{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.8.0/schema.json",
  "name": "flows",
  "position": {
    "x": 280,
    "y": 545,
    "z": 0,
    "height": 160,
    "width": 975,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendario Base"
                    }
                  },
                  "Property": "YearMonth"
                }
              },
              "queryRef": "Calendario Base.YearMonth",
              "nativeQueryRef": "YearMonth",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas DAX"
                    }
                  },
                  "Property": "Entradas simuladas"
                }
              },
              "queryRef": "Medidas DAX.Entradas simuladas",
              "nativeQueryRef": "Entradas simuladas"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas DAX"
                    }
                  },
                  "Property": "Salidas simuladas"
                }
              },
              "queryRef": "Medidas DAX.Salidas simuladas",
              "nativeQueryRef": "Salidas simuladas"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Flujos simulados por mes'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}