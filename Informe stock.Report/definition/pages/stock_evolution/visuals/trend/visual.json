{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.8.0/schema.json",
  "name": "trend",
  "position": {
    "x": 280,
    "y": 250,
    "z": 0,
    "height": 280,
    "width": 975,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendario Base"
                    }
                  },
                  "Property": "YearMonth"
                }
              },
              "queryRef": "Calendario Base.YearMonth",
              "nativeQueryRef": "YearMonth",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas DAX"
                    }
                  },
                  "Property": "Stock cierre mensual"
                }
              },
              "queryRef": "Medidas DAX.Stock cierre mensual",
              "nativeQueryRef": "Stock cierre mensual"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Stock al último cierre mensual'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}